<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MunibinAppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FDF8F0</item>
        <item name="android:navigationBarColor">#FDF8F0</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#FDF8F0</item>
        <item name="android:colorAccent">#92400E</item>
        <item name="android:windowSplashScreenBackground">#FDF8F0</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/munibin_launch_mark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>
</resources>
