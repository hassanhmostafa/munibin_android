<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ limits collapsed custom notifications to 48dp. Full times are in the expanded panel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_live_container"
    android:layout_width="match_parent" android:layout_height="48dp"
    android:background="@color/prayer_live_background" android:layoutDirection="ltr"
    android:gravity="center_vertical" android:orientation="horizontal" android:padding="4dp">
    <ImageView android:id="@+id/prayer_live_icon" android:layout_width="22dp" android:layout_height="22dp"
        android:src="@drawable/ic_prayer_clock" android:contentDescription="@string/prayer_live_channel_name"
        android:layout_marginEnd="6dp" />
    <TextView android:id="@+id/prayer_live_target" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
        android:textColor="@color/prayer_live_primary" android:textDirection="rtl" android:textSize="14sp" />
    <TextView android:id="@+id/prayer_live_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="6dp" android:fontFamily="@font/widget_latin_digits" android:textLocale="en-US"
        android:includeFontPadding="false" android:textColor="@color/prayer_live_accent" android:textDirection="ltr"
        android:textSize="20sp" />
    <TextView android:id="@+id/prayer_live_deadline" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="6dp" android:fontFamily="@font/widget_latin_digits" android:textLocale="en-US"
        android:includeFontPadding="false" android:textColor="@color/prayer_live_accent" android:textDirection="ltr"
        android:textSize="18sp" android:visibility="gone" />
    <TextView android:id="@+id/prayer_live_close" android:layout_width="40dp" android:layout_height="40dp"
        android:gravity="center" android:text="×" android:contentDescription="@string/prayer_live_close"
        android:textColor="@color/prayer_live_secondary" android:textSize="22sp" />
</LinearLayout>
