<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/prayer_widget_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:layoutDirection="ltr">
    <ImageView android:id="@+id/prayer_widget_theme_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" android:src="@drawable/prayer_widget_background_dark" />
    <LinearLayout android:id="@+id/prayer_widget_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:layoutDirection="ltr" android:orientation="vertical" android:paddingStart="8dp" android:paddingTop="7dp" android:paddingEnd="8dp" android:paddingBottom="5dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layoutDirection="ltr" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:layoutDirection="ltr" android:orientation="vertical">
                <TextView android:id="@+id/prayer_widget_next_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="left" android:includeFontPadding="false" android:maxLines="2" android:text="الفجر بعد" android:textColor="@color/prayer_widget_dark_primary" android:textDirection="rtl" android:textSize="15sp" android:textStyle="bold" android:visibility="visible" />
                <LinearLayout android:id="@+id/prayer_widget_countdown_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layoutDirection="ltr" android:gravity="left|center_vertical" android:orientation="horizontal" android:visibility="visible">
                    <TextView android:id="@+id/prayer_widget_countdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/widget_latin_digits" android:textLocale="en-US" android:includeFontPadding="false" android:textDirection="ltr" android:textColor="@color/prayer_widget_dark_highlight" android:textSize="29sp" android:textStyle="bold" android:text="8:31:16" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/prayer_widget_header_info" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:layoutDirection="ltr" android:gravity="right" android:orientation="vertical">
                <TextView android:id="@+id/prayer_widget_brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="right" android:includeFontPadding="false" android:text="منيبين" android:textColor="@color/prayer_widget_dark_accent" android:textDirection="rtl" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/prayer_widget_hijri" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="right" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:text="28 ربيع الثاني 1448" android:textColor="@color/prayer_widget_dark_secondary" android:textDirection="rtl" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:id="@+id/prayer_widget_sunrise_strip" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:visibility="visible">
            <ImageView android:id="@+id/prayer_widget_sunrise_shell" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" android:src="@drawable/prayer_widget_icon_shell_dark" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layoutDirection="ltr" android:gravity="center" android:orientation="horizontal" android:paddingTop="3dp" android:paddingBottom="3dp">
                <TextView android:id="@+id/prayer_widget_sunrise_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:text="07:45" android:textColor="@color/prayer_widget_dark_primary" android:textDirection="ltr" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/prayer_widget_sunrise_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="7dp" android:includeFontPadding="false" android:text="الشروق" android:textColor="@color/prayer_widget_dark_primary" android:textDirection="rtl" android:textSize="12sp" />
                <ImageView android:id="@+id/prayer_widget_sunrise_icon" android:layout_width="15dp" android:layout_height="15dp" android:layout_marginLeft="5dp" android:importantForAccessibility="no" android:src="@drawable/ic_prayer_sunrise" />
            </LinearLayout>
        </FrameLayout>
        <TextView android:id="@+id/prayer_widget_divider" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginBottom="10dp" android:background="@color/prayer_widget_dark_divider" android:text="" android:visibility="visible" />
        <LinearLayout android:id="@+id/prayer_widget_timings_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layoutDirection="ltr" android:gravity="center" android:orientation="horizontal" android:visibility="visible">
            <LinearLayout android:id="@+id/prayer_widget_isha_column" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/prayer_widget_isha_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="العشاء" android:textColor="@color/prayer_widget_dark_primary" android:textDirection="rtl" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/prayer_widget_isha_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="sans-serif-medium" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="20:36" android:textColor="@color/prayer_widget_dark_primary" android:textDirection="ltr" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/prayer_widget_isha_offset" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="@font/widget_latin_digits" android:textLocale="en-US" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="+20" android:textColor="#B8FFF7DE" android:textDirection="ltr" android:textSize="11sp" android:textStyle="normal" android:visibility="visible" />
                <TextView android:id="@+id/prayer_widget_isha_underline" android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:layout_marginTop="3dp" android:background="@color/prayer_widget_dark_highlight" android:text="" android:visibility="invisible" />
            </LinearLayout>
            <LinearLayout android:id="@+id/prayer_widget_maghrib_column" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/prayer_widget_maghrib_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="المغرب" android:textColor="@color/prayer_widget_dark_primary" android:textDirection="rtl" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/prayer_widget_maghrib_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="sans-serif-medium" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="18:51" android:textColor="@color/prayer_widget_dark_primary" android:textDirection="ltr" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/prayer_widget_maghrib_offset" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="@font/widget_latin_digits" android:textLocale="en-US" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="+10" android:textColor="#B8FFF7DE" android:textDirection="ltr" android:textSize="11sp" android:textStyle="normal" android:visibility="visible" />
                <TextView android:id="@+id/prayer_widget_maghrib_underline" android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:layout_marginTop="3dp" android:background="@color/prayer_widget_dark_highlight" android:text="" android:visibility="invisible" />
            </LinearLayout>
            <LinearLayout android:id="@+id/prayer_widget_asr_column" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/prayer_widget_asr_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="العصر" android:textColor="@color/prayer_widget_dark_primary" android:textDirection="rtl" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/prayer_widget_asr_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="sans-serif-medium" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="16:15" android:textColor="@color/prayer_widget_dark_primary" android:textDirection="ltr" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/prayer_widget_asr_offset" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="@font/widget_latin_digits" android:textLocale="en-US" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="+15" android:textColor="#B8FFF7DE" android:textDirection="ltr" android:textSize="11sp" android:textStyle="normal" android:visibility="visible" />
                <TextView android:id="@+id/prayer_widget_asr_underline" android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:layout_marginTop="3dp" android:background="@color/prayer_widget_dark_highlight" android:text="" android:visibility="invisible" />
            </LinearLayout>
            <LinearLayout android:id="@+id/prayer_widget_dhuhr_column" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/prayer_widget_dhuhr_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="الظهر" android:textColor="@color/prayer_widget_dark_primary" android:textDirection="rtl" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/prayer_widget_dhuhr_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="sans-serif-medium" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="13:19" android:textColor="@color/prayer_widget_dark_primary" android:textDirection="ltr" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/prayer_widget_dhuhr_offset" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="@font/widget_latin_digits" android:textLocale="en-US" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="+15" android:textColor="#B8FFF7DE" android:textDirection="ltr" android:textSize="11sp" android:textStyle="normal" android:visibility="visible" />
                <TextView android:id="@+id/prayer_widget_dhuhr_underline" android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:layout_marginTop="3dp" android:background="@color/prayer_widget_dark_highlight" android:text="" android:visibility="invisible" />
            </LinearLayout>
            <LinearLayout android:id="@+id/prayer_widget_fajr_column" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/prayer_widget_fajr_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="الفجر" android:textColor="@color/prayer_widget_dark_highlight" android:textDirection="rtl" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/prayer_widget_fajr_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="sans-serif-medium" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="05:54" android:textColor="@color/prayer_widget_dark_highlight" android:textDirection="ltr" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/prayer_widget_fajr_offset" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="@font/widget_latin_digits" android:textLocale="en-US" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="+20" android:textColor="#B885F0AB" android:textDirection="ltr" android:textSize="11sp" android:textStyle="normal" android:visibility="visible" />
                <TextView android:id="@+id/prayer_widget_fajr_underline" android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:layout_marginTop="3dp" android:background="@color/prayer_widget_dark_highlight" android:text="" android:visibility="visible" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/prayer_widget_empty_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="فعّل مواقيت الصلاة من التطبيق لعرض المواقيت هنا" android:textColor="@color/prayer_widget_dark_secondary" android:textDirection="rtl" android:textSize="11sp" android:visibility="gone" />
        <FrameLayout android:id="@+id/prayer_widget_empty_refresh_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="7dp" android:layout_marginBottom="2dp" android:visibility="gone">
            <ImageView android:id="@+id/prayer_widget_empty_refresh_shell" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <TextView android:id="@+id/prayer_widget_empty_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="فتح مواقيت الصلاة" android:gravity="center" android:includeFontPadding="false" android:paddingStart="12dp" android:paddingTop="6dp" android:paddingEnd="12dp" android:paddingBottom="6dp" android:text="فتح مواقيت الصلاة" android:textColor="@color/prayer_widget_dark_accent" android:textDirection="rtl" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
